#: src/Widgets/PreferencesPopover.vala:92
msgid ""
"Fast cycle through the metadata from the playing stream if show stream info "
"is enabled"
msgstr ""
"Fast cyclus door de metadata van de speelstroom als de info in staat is"

#: src/Widgets/PreferencesPopover.vala:96
msgid "Stream metadata image popup"
msgstr "Stream metadata beeld popup"

#: src/Widgets/PreferencesPopover.vala:98
msgid "Show a movable popup with images discovered in the stream metadata"
msgstr ""
"Toon een bescheiden popup met beelden die ontdekt worden in de rivier "
"metadata"

#: src/Widgets/PreferencesPopover.vala:102
msgid "Shrink title dynamically with the text"
msgstr "Shrink titel dynamisch met de tekst"

#: src/Widgets/PreferencesPopover.vala:104
msgid "Shrink the title according to the length of the displayed text."
msgstr "Shrink de titel volgens de lengte van de vertoonde tekst."

